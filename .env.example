# Copy to .env and set your own values (.env is gitignored).
#
# Secret key: generate one with
#   docker compose run --rm web python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=change-me
# 0 = normal use. 1 = local development only (detailed error pages); never with LAN mode.
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
POSTGRES_DB=twin
POSTGRES_USER=twin
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=db
POSTGRES_PORT=5432
# LAN mode (off by default): this computer's address on a TRUSTED home network, so a phone
# on the same Wi-Fi can open http://<address>:8000/. Plain HTTP (prefer LAN HTTPS below):
# never on shared or public Wi-Fi. Refuses to start while DJANGO_DEBUG=1.
# TWIN_LAN_HOST=192.168.1.20
# LAN HTTPS (M6, recommended for the phone): this computer's address; serves https://<address>:8443/
# with the certificate from scripts/lan-cert.ps1 (README, "LAN HTTPS"). Start with
# `docker compose --profile https up -d web-https`. Leave TWIN_LAN_HOST empty when you use this.
# TWIN_HTTPS_HOST=192.168.1.20
# dtom live ingest (POST /api/twin/minute): off while empty. Make one with
#   docker compose exec web python manage.py make_ingest_token
# DTOM_INGEST_TOKEN=
# The contributor whose data the app shows (one per instance).
# TWIN_CONTRIBUTOR=mike
# Encrypted backup (M4.5, opt-in: docker compose --profile backup up -d backup).
# RCLONE_CONFIG_HOST: full path to YOUR rclone.conf, outside this folder (docs/OPERATIONS.md shows how
# to create it). BACKUP_REMOTE: the crypt remote in it, with a trailing colon.
# RCLONE_CONFIG_HOST=C:/Users/you/.config/twin/rclone.conf
# BACKUP_REMOTE=twin-crypt:
BACKUP_WINDOW=02:00-05:00
BACKUP_INCLUDE_INBOX=0
